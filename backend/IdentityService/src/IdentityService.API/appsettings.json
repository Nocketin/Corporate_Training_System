{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Database=identitydb;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "super_secret_development_key_change_me",
    "Issuer": "IdentityService",
    "Audience": "CorporateTrainingFrontend",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "ConsulConfig": {
    "Host": "http://consul:8500",
    "ServiceName": "IdentityService",
    "ServiceId": "identityservice-1",
    "ServiceAddress": "identityservice",
    "ServicePort": "5000"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://seq:5341" } }
    ]
  }
}
