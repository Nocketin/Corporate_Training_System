{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Database=notificationdb;Username=postgres;Password=postgres"
  },
  "Kafka": {
    "Host": "kafka:9092"
  },
  "ConsulConfig": {
    "Host": "http://consul:8500",
    "ServiceName": "NotificationService",
    "ServiceId": "notificationservice-1",
    "ServiceAddress": "notificationservice",
    "ServicePort": "5003"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://seq" } }
    ]
  }
}
