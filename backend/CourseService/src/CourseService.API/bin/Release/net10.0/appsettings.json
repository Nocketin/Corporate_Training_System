{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Database=coursesdb;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "Redis": {
    "Configuration": "redis:6379"
  },
  "Kafka": {
    "Host": "kafka:9092"
  },
  "Minio": {
    "ServiceUrl": "http://minio:9000",
    "AccessKey": "minio",
    "SecretKey": "minio123",
    "Bucket": "courses"
  },
  "Jwt": {
    "Key": "super_secret_development_key_change_me",
    "Issuer": "IdentityService",
    "Audience": "CorporateTrainingFrontend"
  },
  "ConsulConfig": {
    "Host": "http://consul:8500",
    "ServiceName": "CourseService",
    "ServiceId": "courseservice-1",
    "ServiceAddress": "courseservice",
    "ServicePort": "5001"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://seq" } }
    ]
  }
}
